# RELAY Frontend Environment Variables
#
# Backend API Base URL
# Leave blank or omit to use same-origin "/api/v1" with reverse proxy.
# Set to an absolute origin (e.g. http://localhost:8080 or https://api.relay.dev)
# when connecting to an externally deployed RELAY backend service.
#
# NOTE: Do NOT store authentication secrets, API keys, or private tokens in frontend environment variables.
VITE_API_BASE_URL=
