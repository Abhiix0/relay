PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/relay

# GitHub OAuth app (callback: <PUBLIC_APP_URL>/api/v1/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPE=read:user user:email public_repo
# overrides the derived callback URL
# GITHUB_CALLBACK_URL=
# shared secret for POST /api/v1/webhooks/github (leave unset to disable webhooks)
# GITHUB_WEBHOOK_SECRET=

# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# browser origin of the web app; also the allowed Origin for state-changing requests
PUBLIC_APP_URL=http://localhost:5200
# reverse proxies in front of the API (X-Forwarded-For hops to trust)
TRUST_PROXY=1
MAX_PROJECTS_PER_USER=10

# LLM answers, handoffs and onboarding (leave unset to get 503 "AI is not configured")
# GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
