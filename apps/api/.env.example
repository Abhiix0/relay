PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/relay

# GitHub OAuth app (callback: <PUBLIC_APP_URL>/api/v1/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPE=read:user user:email public_repo
# overrides the derived callback URL
# GITHUB_CALLBACK_URL=
# shared secret for POST /api/v1/webhooks/github (leave unset to disable webhooks)
# GITHUB_WEBHOOK_SECRET=

# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# browser origin of the web app; also the allowed Origin for state-changing requests
PUBLIC_APP_URL=http://localhost:5200
# reverse proxies in front of the API (X-Forwarded-For hops to trust)
TRUST_PROXY=1
MAX_PROJECTS_PER_USER=10

# LLM answers, handoffs and onboarding (leave unset to get 503 "AI is not configured")
# GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# Set to false to skip the local embedding model (search/ask fall back to keyword retrieval)
EMBEDDINGS_ENABLED=true

# Sync memory limits (defaults shown; see README "Small instances")
# SYNC_FILE_BATCH=25
# EMBED_BATCH=8
# SYNC_MAX_CONCURRENT=1
# SYNC_MAX_FILES=2000
# SYNC_MAX_FILE_BYTES=262144
# refuse repositories larger than this many KB (GitHub-reported size)
# SYNC_MAX_REPO_KB=51200
# fail a sync when process RSS exceeds this many MB (0 = disabled)
# SYNC_RSS_LIMIT_MB=0
# log process memory (numbers only) during sync: true/false
# LOG_MEMORY=false
