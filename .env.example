# ─────────────────────────────────────────────────────────────
# Relay environment variables
# Copy this file to .env.local and edit values as needed.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Set to "false" to disable MSW mocks and hit a real backend.
# Default is "true" — all API calls are intercepted by MSW during local dev.
VITE_USE_MOCKS=true

# Base URL for the real backend API (only used when VITE_USE_MOCKS=false).
# VITE_API_BASE_URL=http://localhost:4000
